/* 向导编辑器 —— 只写**项目没有**的东西
 * ============================================================================
 *  ⛔⛔ 三条纪律（2026-10-04 定）：
 *
 *  1. ⛔ 不重定义 styles.css 里已有的类。
 *     本文件曾经重复定义 .pipe-map / .pipe-step / .pipe-dot / .pipe-seg /
 *     .expert-block / .expert-summary / .expert-warning / .expert-unlock /
 *     .expert-fields 共 9 个 —— 而 editor 又 import 了 styles.css，
 *     ⛔ 同名不同义 + 同时加载 ⇒ 谁生效取决于 import 顺序。
 *     已全部删除，改用项目自己的那套（TrainingTab 就是这么用的）。
 *
 *  2. ⛔ 不重画已有容器。项目的规范形状是：
 *       .section > .section-hdr + .section-body      分段（三件套，15 处在用）
 *       .collapsible > .collapsible-hdr + -body     折叠区（8 处在用）
 *       .field + .field-label + .field-hint          字段（32 + 37 处在用）
 *       .msg / .msg-info / .msg-danger              提示条（41 处在用）
 *       .form-grid / .param-grid                    网格
 *       .workspace-container                        居中容器（max-width:1400px）
 *     ⇒ 本文件只负责「向导特有的东西」：诊断条的内容、轨道上方的说明、
 *       计划步骤列表。⛔ 容器一律用项目类名。
 *
 *  3. ⛔ 不自己定字号/间距。项目的字号阶梯就在 styles.css 里
 *     （.section-hdr 10px / .field-hint 10px / .msg 12px / .form-grid gap 6px 8px…）
 *     ⇒ 照抄那些值，⛔ 不另立一套。
 * ============================================================================ */

/* ---- 居中容器：⛔ 复用项目的类，不自己写 max-width ----
   项目那边是 .workspace-container { padding:.5rem .75rem; max-width:1400px; margin:0 auto }
   向导是独立页面 ⇒ 直接用项目那个类，⛔ 不另建一个容器。*/

.dg-hdr-title { font-size: 12px; font-weight: 600; color: var(--text) }
.dg-hdr-chips { display: flex; gap: 6px; flex: 1; flex-wrap: wrap }
.dg-caret { font-size: 12px; color: var(--muted) }

/* 计数徽标 —— ⭐ 用项目的语义色变量
   ⚠ 我原来手抄了 5 个 rgba 常量（rgba(207,102,121,0.1) 之类）。
      项目已经给了 --accent-soft（accent 的 15%）这个手法，
      而 .msg-info 的写法是 rgba(100,181,246,0.1) —— 跟着它走，别自己发明。*/
.dg-chip {
  font-size: 10px; padding: 1px 7px;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
}
.dg-chip.err { color: var(--danger);   background: rgba(207,102,121,0.1); border-color: var(--danger) }
.dg-chip.wrn { color: var(--warning); background: rgba(255,183,77,0.1);  border-color: var(--warning) }
.dg-chip.inf { color: var(--info);    background: rgba(100,181,246,0.1);  border-color: var(--info) }
.dg-chip.ok  { color: var(--success); background: rgba(76,175,80,0.1);   border-color: var(--success) }

.dg-empty { color: var(--muted); font-size: 12px; padding: 8px 0 }

.dg-sum {
  padding: 8px 10px;
  font-size: 12px;
  font-weight: 600;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
}
.dg-sum.ok  { background: rgba(76,175,80,0.1);   color: var(--success); border-color: var(--success) }
.dg-sum.wrn { background: rgba(255,183,77,0.1);  color: var(--warning); border-color: var(--warning) }
.dg-sum.err { background: rgba(207,102,121,0.1); color: var(--danger);  border-color: var(--danger) }
.dg-sum-sub { font-weight: 400; font-size: 11px; margin-top: 3px; opacity: .85 }

/* 一条诊断 —— ⭐ 这其实是项目 .msg 的形状（padding 8px 12px + radius-sm + 语义色边框）
   ⛔ 不重写它：诊断条就是若干条 .msg，本文件不该有一套并行的。 */
.dg-row {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  padding: 6px 8px;
  border-radius: var(--radius-sm);
  margin-top: 5px;
  font-size: 12px;
  border: 1px solid transparent;
}
.dg-row.e { background: rgba(207,102,121,0.1); border-color: var(--danger);  color: var(--danger) }
.dg-row.w { background: rgba(255,183,77,0.1);  border-color: var(--warning); color: var(--warning) }
.dg-row.i { background: rgba(100,181,246,0.1);  border-color: var(--info);    color: var(--info) }

.dg-tag {
  flex: 0 0 auto;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: var(--radius-sm);
  color: var(--bg);
  font-weight: 700;
}
.dg-row.e .dg-tag { background: var(--danger) }
.dg-row.w .dg-tag { background: var(--warning) }
.dg-row.i .dg-tag { background: var(--info) }

.dg-msg { min-width: 0; color: var(--text) }
.dg-where {
  display: inline-block;
  background: var(--panel);
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 5px;
  font-size: 11px;
  margin-bottom: 2px;
}

/* ============================================================
   填表视图 —— ⭐ 让人不用碰 JSON
   ============================================================ */
.mf-switch { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden }
.mf-tab {
  border: 0; background: var(--surface); color: var(--muted);
  font-size: 11px; padding: 3px 10px; cursor: pointer;
}
.mf-tab.on { background: var(--accent); color: var(--bg) }

.mf-scroll { flex: 1; overflow: auto; padding: 10px 12px 40px }
.mf-top { font-size: 12px; color: var(--muted); margin-bottom: 8px }
.mf-top b { font-size: 14px; color: var(--text) }

/* ⭐ 段落容器直接用项目的 .section / .section-hdr / .section-body，
   这里只补一条间距 —— 不重画卡片。 */
.mf-section { margin-bottom: 12px }

/* 一个字段：键 + 说明 + 填错的后果 + 输入框
   （输入框用项目的 .control，说明用项目的 .field-hint） */
.mf { display: flex; flex-direction: column; gap: 3px; margin-bottom: 12px }
.mf .field-label { display: flex; align-items: center; gap: 6px }
.mf .field-label code {
  background: var(--panel); color: var(--text);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 1px 5px; font-size: 11px;
}
/* ⛔ 静默失效字段 —— 用 --danger，与诊断条同一套色 */
.mf-flag {
  font-style: normal; font-size: 10px; color: var(--danger);
  background: rgba(207,102,121,0.1); border: 1px solid var(--danger);
  border-radius: var(--radius-sm); padding: 0 5px;
}
/* ⛔ 「填错会怎样」 —— 用 --warning */
.mf-w { font-size: 11px; color: var(--warning); line-height: 1.5 }
.mf-s {
  font: 11px/1.5 ui-monospace, Consolas, monospace; margin: 4px 0 0;
  background: var(--panel); color: var(--muted);
  border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 6px 8px; white-space: pre-wrap;
}
.mf-intro { font-size: 11px; color: var(--muted); line-height: 1.6; margin: 0 0 10px }

/* ---- 参数行 ---- */
.pr {
  border: 1px dashed var(--border); border-radius: var(--radius-md);
  padding: 8px 10px; margin-bottom: 8px; background: var(--panel);
}
.pr-head { display: flex; gap: 6px; align-items: center; margin-bottom: 8px }
.pr-name { flex: 1 }
.pr-type { width: 90px }
.pr-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px 10px }
.pr-grid label { display: flex; flex-direction: column; gap: 2px }
.pr-grid label > span { font-size: 10px; color: var(--muted) }
.pr-grid .two { display: flex; gap: 4px }
.pr-grid .two input { width: 50% }
.pr-more { margin-top: 6px; font-size: 11px; color: var(--muted) }
.pr-more summary { cursor: pointer; user-select: none }
.pr-more .pr-grid { margin-top: 8px }
/* ⛔ 与 .msg-warning 同一套配色，不另造浅黄 */
.pr-warn {
  margin: 8px 0 0; font-size: 11px;
  background: rgba(255,183,77,0.1); color: var(--warning);
  border: 1px solid var(--warning); border-radius: var(--radius-sm);
  padding: 6px 8px; line-height: 1.5;
}
.mf-add { margin-top: 4px }

/* ⛔ 不许硬编码颜色 —— 一律走项目变量 */
.mf-hint {
  font-size: 12px; line-height: 1.6; margin-bottom: 14px;
  background: rgba(255,183,77,0.1); color: var(--warning);
  border: 1px solid var(--warning); border-radius: var(--radius-sm);
  padding: 8px 10px;
}
.mf-hint b { color: var(--warning) }
.mf-jsonerr {
  padding: 6px 10px; font-size: 11px;
  color: var(--danger); background: rgba(207,102,121,0.1);
  border-top: 1px solid var(--danger);
}

/* ============================================================
   六步导航条
   ============================================================ */
/* ---- 每一步的容器
   ⚠ 这里只加**间距**（各步之间的分隔），⛔ 边框/圆角/背景
     全部交给项目的 .section-hdr + .section-body 那一套
     （见 styles.css：.section 负责框，.section-hdr 负责标题行）。*/
.step-block { margin-bottom: 14px }

/* ---- prepare 内部三小步的状态条（照 PipelineMap 的 glyph）---- */
.prep-phases {
  display: flex; flex-wrap: wrap; align-items: stretch;
  gap: 0; list-style: none; margin: 0 0 12px; padding: 0;
}
.prep-phase {
  position: relative; display: flex; align-items: center; gap: 6px;
  padding: 4px 14px 4px 10px; font-size: 12px; color: var(--muted);
}
.prep-phase.blocked { opacity: .45 }

/* ---- 顶层页签条
   ⚠ 按钮本身用**项目的** .nav-btn（web/src/App.jsx:216 就是它），
     这里只加「一排 + 间距」——
     ⛔ 不重画 .nav-btn（那会跟项目那份打架，见文件头的纪律）。*/
.ed-nav {
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 12px; flex-wrap: wrap;
}
