{
  "contract_version": 2,
  "id": "fixture-alpha",
  "label": "Fixture Alpha",
  "upstream": {
    "url": "https://github.com/example/fixture-alpha",
    "commit": "0123456789abcdef0123456789abcdef01234567",
    "license": "MIT"
  },
  "default_base_url": "http://127.0.0.1:19880",
  "base_url_env": "FIXTURE_ALPHA_BASE_URL",
  "timeout_ms": 300000,
  "timeout_ms_source": "estimated",
  "max_chars": 60,
  "max_chars_source": "estimated",
  "capabilities": {
    "requires_reference_audio": true,
    "reference_clip_seconds": [
      3,
      10
    ],
    "streaming": true,
    "output_sample_rate": 32000,
    "supports_finetune": false
  },
  "runtime": {
    "python": "engines/fixture-alpha/.venv",
    "entry": "../../lib/inference/infer_server.py",
    "args": [
      "-a",
      "{host}",
      "-p",
      "{port}",
      "-c",
      "{root}/lib/inference/tts_infer.yaml"
    ],
    "cwd": ".",
    "checkpoints": "models/tts/fixture-alpha",
    "ready_endpoint": "/health",
    "ready_timeout_ms": 180000,
    "ready_timeout_ms_source": "estimated",
    "preload": false,
    "verify": {
      "sys_path": [
        "engines/fixture-alpha/infer",
        "engines/fixture-alpha"
      ],
      "imports": [
        {
          "module": "TTS",
          "class": "TTS",
          "methods": [
            "run",
            "set_ref_audio"
          ]
        }
      ]
    }
  },
  "maps": {
    "text": "text",
