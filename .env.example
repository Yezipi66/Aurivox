# HaremCore TTS Broker - local defaults
BROKER_HOST=127.0.0.1
BROKER_PORT=9886

# Optional local auth token. Leave empty to disable auth.
# If set, clients must send: Authorization: Bearer <token>
BROKER_API_KEY=

# Self-contained inference server endpoint (lib/inference/infer_server.py).
# Started automatically by start.ps1 / start.bat on this port — no external engine needed.
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880

# If true, broker will call /set_gpt_weights and /set_sovits_weights before each synthesis.
# Useful for multi-voice setups, slower for single voice.
GPT_SOVITS_SWITCH_MODELS=true

# Public base URL used only when reporting metadata; audio/speech returns bytes directly.
BROKER_PUBLIC_BASE_URL=http://127.0.0.1:9886
