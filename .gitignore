# ─────────────────────────────────────────────────────────────
#  TTS Broker — .gitignore
#  Mirrors pack_sources.py exclusions: runtime output, models,
#  caches and heavy binaries are never committed.
# ─────────────────────────────────────────────────────────────

# Runtime generation output (Generate / Compare Refs / Broker)
/outputs/
/output/
_silence_*.wav
_concat_*.txt

# Logs & temp
/logs/
/log/
/tmp/
/temp/
*.log

# Node
node_modules/
dist/
/build/ 

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local secrets / env (keep .env.example tracked)
.env
.env.local
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Atomic-resume staging & gradio scratch
.staging/
.gradio/
.cache/

# ─── Model weights & checkpoints (large binaries, never in git) ───
pretrained/
pretrained_models/
uvr5_weights/
uvr5/uvr5_weights/
SoVITS_weights/
GPT_weights/
sovits_models/
gpt_checkpoints/
faster-whisper-large-v3-turbo/
chinese-hubert-base/
chinese-roberta-wwm-ext-large/
*.pth
*.ckpt
*.pt
*.onnx
*.bin
*.safetensors
*.h5
*.pb
*.tflite
*.engine
*.plan
*.index
*.npz
*.npy
*.pkl
*.pickle
*.model
*.gguf
*.ggml
*.wts

