*.exe
*.dll
*.so
*.dylib

# runtime data & user assets
/assets/
/data/
/recipes/
app-config.json
voices.json
lib/voices.json
# vendored runtime / models / third-party
GPT_SoVITS/
vendor/
tools/runtime/
lib/training/gsv-tools/asr/models/
lib/training/gsv-tools/asr/faster-whisper-*/
