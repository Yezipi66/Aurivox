# ─────────────────────────────────────────────────────────────
#  TTS Broker — .gitignore
#  Mirrors pack_sources.py exclusions: runtime output, models,
#  caches and heavy binaries are never committed.
# ─────────────────────────────────────────────────────────────

# Runtime generation output (Generate / Compare Refs / Broker)
/outputs/
/output/
_silence_*.wav
_concat_*.txt
lib/inference/tts_infer.yaml
lib/inference/tts_infer.yaml.bak-*

# Logs & temp
/logs/
/log/
/tmp/
/temp/
*.log

# Node
node_modules/
dist/
/build/ 

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local secrets / env (keep .env.example tracked)
.env
.env.local
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Atomic-resume staging & gradio scratch
.staging/
.gradio/
.cache/
# Runtime caches. r12c batch13 consolidated every cache under cache/
# (see lib/paths.js CACHE_DIR / CACHE). The bare .numba_cache/ line stays so a
# tree that predates the move keeps ignoring its leftovers.
cache/
.numba_cache/

