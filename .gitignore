# ─────────────────────────────────────────────────────────────
#  TTS Broker — .gitignore
#  Mirrors pack_sources.py exclusions: runtime output, models,
#  caches and heavy binaries are never committed.
# ─────────────────────────────────────────────────────────────

# Runtime generation output (Generate / Compare Refs / Broker)
/outputs/
/output/
_silence_*.wav
_concat_*.txt
lib/inference/tts_infer.yaml
lib/inference/tts_infer.yaml.bak-*

# Logs & temp
/logs/
/log/
/tmp/
/temp/
*.log

# Node
node_modules/
dist/
/build/ 

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local secrets / env (keep .env.example tracked)
.env
.env.local
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Atomic-resume staging & gradio scratch
.staging/
.gradio/
.cache/
# numba JIT cache, created at runtime by the inference stack
.numba_cache/

# ─── Model weights & checkpoints (large binaries, never in git) ───
pretrained/
pretrained_models/
uvr5_weights/
uvr5/uvr5_weights/
SoVITS_weights/
GPT_weights/
sovits_models/
gpt_checkpoints/
faster-whisper-large-v3-turbo/
chinese-hubert-base/
chinese-roberta-wwm-ext-large/
*.pth
*.ckpt
*.pt
*.onnx
*.bin
*.safetensors
*.h5
*.pb
*.tflite
*.engine
*.plan
*.index
*.npz
*.npy
*.pkl
*.pickle
*.model
*.gguf
*.ggml
*.wts

# ─── Media & archives (generated / downloaded assets) ───
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.opus
*.aac
*.wma
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
*.zst

# Bundled binaries (ffmpeg, etc.)
*.exe
*.dll
*.so
*.dylib

# runtime data & user assets
/assets/
# Use /data/* (not /data/) so the negations below can take effect.
# A directory-form rule stops git from descending into the directory,
# and then no negation inside it can ever work.
/data/*
# These two are configuration, not regenerable cache: keep them tracked.
!/data/advanced_params.json
!/data/training_defaults.json
/recipes/
app-config.json
voices.json
lib/voices.json
# vendored runtime / models / third-party
GPT_SoVITS/
# vendor/ holds third-party SOURCE, which is tracked. Ignore everything
# under it by default and re-admit the trees we vendor deliberately, so a
# new binary payload cannot slip in unnoticed.
/vendor/*
!/vendor/gsv-tools/
!/vendor/gsv_code/
!/vendor/gsv-infer/
tools/runtime/
vendor/gsv-tools/asr/models/
vendor/gsv-tools/asr/faster-whisper-*/
vendor/gsv_code/text/ja_userdic/
# backups & junk
*.bak
*.bak[0-9]
*.bak[0-9].*
*.bak.*
nul
try_indextts2*.ps1
setup_indextts_env_v2.bat

# generated release artifacts (gen_version.py / gen_manifest.py)
/version.json
/manifest-*.json

# ASR outputs
*.list
*.conf.json

tools/deploy/.deploy_*.txt
tools/deploy/.deploy_selection.json
.patch-backup/
aurivox-*-update
backups/